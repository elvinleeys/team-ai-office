NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# publishable 키 (sb_publishable_...). 브라우저에 노출돼도 되는 키
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# secret 키 (sb_secret_...). 서버 전용, 절대 NEXT_PUBLIC_으로 만들지 않는다
SUPABASE_SECRET_KEY=
SITE_URL=http://localhost:3000
MCP_SERVER_URL=http://127.0.0.1:8787/mcp
# 아래는 node scripts/create-github-app.mjs 가 자동으로 채운다
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# 개인 프로젝트 PAT 암호화 키 (32바이트 base64). mcp-server/.env와 같은 값
GITHUB_TOKEN_ENC_KEY=
