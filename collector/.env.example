# MCP 서버 주소. 처음 한 번 `node --env-file=.env collector.ts --login`으로 로그인한다 (Claude Code와 같은 OAuth, 브라우저에서 허용)
TEAM_OFFICE_MCP_URL=https://team-office-mcp.team-office-mcp.workers.dev/mcp
# 수집 주기(분). 10 미만이면 10으로 올린다
COLLECT_MINUTES=15
# (선택) 로그인 토큰 저장 위치. 기본 ~/.team-office/collector.json
# COLLECTOR_AUTH_FILE=
