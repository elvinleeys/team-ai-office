SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase 대시보드 > Project Settings > API Keys 의 secret 키 (sb_secret_...). 절대 커밋하지 않는다.
SUPABASE_SECRET_KEY=
PORT=8787
HOST=127.0.0.1
# 클라이언트가 접속하는 이 서버의 공개 주소 (끝 / 없이). OAuth 메타데이터·401 안내에 쓴다. 비우면 요청 Host를 쓴다 (배포 시 꼭 지정)
MCP_PUBLIC_URL=http://127.0.0.1:8787
# M9 칸반 동기화 (GitHub Projects). 0이면 끈다, 최소 30초
GITHUB_SYNC_SECONDS=45
# 개인 프로젝트 PAT 암호화 키 (32바이트 base64). web/.env.local과 같은 값. 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GITHUB_TOKEN_ENC_KEY=
# 조직 프로젝트용 GitHub App 자격 증명 (web/.env.local과 같은 값, 개행은 \n)
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY=
